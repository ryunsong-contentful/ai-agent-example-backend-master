### Copy this file to .env and fill in your secrets. Do NOT commit .env to git.

# GitHub
GITHUB_TOKEN=your_github_token_here

# OpenAI / Vercel AI
OPENAI_API_KEY=your_openai_api_key_here
VERCEL_AI_KEY=your_vercel_ai_key_here

# Anthropic (optional fallback)
ANTHROPIC_KEY=your_anthropic_api_key_here

# Jira Cloud
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your-jira-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Debugging
DEV_SHOW_TOKENS=0

# Slack (optional)
# Bot token (starts with xoxb-) with chat:write scope
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
# Default channel ID to post notifications to (preferred) or channel name like #dev
SLACK_CHANNEL=C01234567
# Toggle Slack notifications on/off by default (0 or 1)
SLACK_NOTIFY=1

# Server
PORT=3000
